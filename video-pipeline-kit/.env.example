# Preferred: keep the key in Doppler (docs/DOPPLER.md) and run everything through ./run.sh.
# Fallback for a machine without Doppler: copy this file to .env (git-ignored) and fill it in.
GEMINI_API_KEY=

# Optional model overrides (defaults are in tools/mv.py). Change if Google renames or retires a model.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# VEO_MODEL=veo-3.1-fast-generate-preview

# Optional: a specific .ttf for captions (otherwise assets/fonts/, then system fonts)
# KIT_FONT=/path/to/Font-Bold.ttf
